# Railway sets PORT automatically; do not hard-code it in production.
# Exact Vercel production URL(s), comma-separated, with no trailing slash.
CORS_ORIGIN=https://TU-FRONTEND.vercel.app
# Mount a Railway Volume at /app/data and keep this directory across deploys.
USER_DATA_DIR=/app/data
# Set to false after the intended participants have registered.
ALLOW_REGISTRATION=true
MAX_CONCURRENT_RUNS=2
